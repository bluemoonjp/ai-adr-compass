{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "practice.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "topic", "applies_to", "rule", "license", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^\\d{4}$", "description": "Must match the leading digits of the file name." },
    "title": { "type": "string", "minLength": 1 },
    "status": { "$ref": "defs.schema.json#/$defs/status" },
    "topic": { "$ref": "defs.schema.json#/$defs/topic" },
    "applies_to": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "defs.schema.json#/$defs/appliesTo" }
    },
    "rule": { "type": "string", "maxLength": 200 },
    "license": {
      "const": "CC-BY-4.0",
      "description": "Applies to the original prose of this file's body text."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "defs.schema.json#/$defs/source" },
      "contains": { "type": "object", "required": ["kind"], "properties": { "kind": { "enum": ["primary", "research"] } } },
      "description": "At least one source must be primary or research; sources cannot rest on \"other\" alone."
    }
  }
}
