{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/anchor" }
    }
  },
  "$defs": {
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "method", "role", "tools", "approval"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "url": { "type": "string", "pattern": "^https://\\S+$" },
        "method": { "enum": ["etag", "md5"] },
        "role": { "enum": ["source", "control-static", "control-changing", "published-static"] },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "defs.schema.json#/$defs/appliesTo" }
        },
        "covers": {
          "type": "array",
          "description": "Other hosts this anchor stands in for. A covering host's registration eTLD+1 is approximated by its last two dot-separated labels, so a multi-label public suffix (co.uk, github.io) is out of scope for this match.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "reason"],
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "minIntervalSec": { "type": "integer", "minimum": 1 },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decidedBy", "on"],
          "properties": {
            "decidedBy": { "const": "human" },
            "on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "probe": {
              "type": "object",
              "additionalProperties": false,
              "required": ["on", "volatile"],
              "properties": {
                "on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "volatile": { "type": "boolean" }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "const": "source" } }, "required": ["role"] },
          "then": {
            "properties": {
              "approval": {
                "type": "object",
                "required": ["probe"],
                "properties": {
                  "probe": {
                    "type": "object",
                    "required": ["on", "volatile"],
                    "properties": {
                      "on": { "type": "string" },
                      "volatile": { "const": false }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
